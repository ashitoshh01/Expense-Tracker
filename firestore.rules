rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: All unauthenticated or unmatched access is denied
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolated user financial documents:
    // Only the authenticated user whose UID matches the document ID can read and write.
    // User A cannot read or modify User B's data.
    match /wallet_data/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow access to subcollections if used in the future
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
